# ---- Core ------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
# REQUIRED: long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- Database / jobs -------------------------------------------------
# docker compose overrides DATABASE_URL / REDIS_URL / JOB_BACKEND.
# Local development without Docker can use SQLite: sqlite+aiosqlite:///./agentready.db
DATABASE_URL=postgresql+asyncpg://agentready:agentready@localhost:5432/agentready
REDIS_URL=redis://localhost:6379/0
# celery (needs Redis + a worker) | inline (in-process asyncio task, development only)
JOB_BACKEND=inline

# ---- AI: Groq REST API via httpx (no SDK) ------------------------------
# groq | mock (LOCAL MOCK, not a real model; for tests/demos) | none
AI_PROVIDER=groq
GROQ_API_KEY=
# Verify availability in the app: Settings > AI usage > Verify model
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# auto | json_schema | json_object
GROQ_RESPONSE_FORMAT=auto
# USD per 1M tokens, used for cost estimates only. Check current Groq pricing.
GROQ_INPUT_PRICE_PER_MTOK=0.15
GROQ_OUTPUT_PRICE_PER_MTOK=0.60
# fallback (AI only when deterministic extraction is insufficient) | always | never
AI_EXTRACTION_MODE=fallback
MAX_AI_CONTENT_CHARS=12000
MAX_AI_CALLS_PER_SCAN=60

# ---- Crawler ---------------------------------------------------------
MAX_PAGES_PER_SCAN=100
MAX_PRODUCTS_PER_SCAN=500
MAX_CRAWL_DEPTH=4
CRAWL_DELAY_SECONDS=1
CRAWL_TIMEOUT_SECONDS=15
MAX_RESPONSE_BYTES=5000000
ALLOWED_PORTS=80,443
# NEVER true in production: disables SSRF blocking of private networks.
ALLOW_PRIVATE_NETWORKS=false
# Requires: pip install -r requirements-playwright.txt && python -m playwright install chromium
PLAYWRIGHT_ENABLED=false

# --- Phase 2: commerce integrations ------------------------------------------
# Encrypts store credentials at rest (required when ENVIRONMENT=production). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=
# Shopify app credentials for OAuth (optional; without them connect with a custom-app Admin API token)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-10
# Public URL of the API (OAuth redirect URI / webhook URLs)
API_BASE_URL=http://localhost:8000

# --- Phase 5: production operation ------------------------------------------------
# Required by docker-compose.prod.yml (see DEPLOYMENT.md). Placeholders only — never commit real values.
# PUBLIC_URL=https://shop-catalog.example.com
# SERVER_NAME=shop-catalog.example.com
# POSTGRES_PASSWORD=
# text | json (one JSON object per line, for log shippers)
LOG_FORMAT=text
LOG_LEVEL=INFO
# Interactive API docs at /docs: default on outside production, off in production
# API_DOCS_ENABLED=false
# Requests with larger bodies get 413 (nginx also limits to 1 MB)
MAX_REQUEST_BODY_BYTES=2000000
# Failed sign-ins per account (any IP) within the window before sign-in is paused
LOGIN_FAILURES_PER_ACCOUNT=10
LOGIN_FAILURE_WINDOW_SECONDS=900
# Database connection pool (per API/worker process)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
# Background jobs still queued/running after this long are treated as interrupted and recovered
JOB_STALE_AFTER_MINUTES=30
SCAN_STALE_AFTER_MINUTES=15
# Process counts (docker images)
# WEB_CONCURRENCY=2
# WORKER_CONCURRENCY=2
